---
// Esta página captura todas las rutas /app/* y monta la SPA de React.
// React Router (basename="/app") toma el control del routing interno.
import '../../styles/global.css';
import App from '../../app/App';

export const prerender = true;
export function getStaticPaths() {
  // En output "static", Astro genera un HTML por cada path listado aquí.
  // Todos renderizan el mismo shell de React; React Router maneja el routing interno.
  return [
    { params: { path: undefined } },          // /app
    { params: { path: 'dashboard' } },        // /app/dashboard
    { params: { path: 'orders' } },           // /app/orders
    { params: { path: 'orders/new' } },       // /app/orders/new
    { params: { path: 'bays' } },             // /app/bays
    { params: { path: 'catalog/services' } }, // /app/catalog/services
    { params: { path: 'catalog/parts' } },    // /app/catalog/parts
    { params: { path: 'reports' } },          // /app/reports
    { params: { path: 'audit' } },            // /app/audit
    { params: { path: 'profile' } },          // /app/profile
  ];
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TallerPro</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-navy-900 text-gray-100">
    <div id="root" class="min-h-screen">
      <App client:only="react" />
    </div>
  </body>
</html>
