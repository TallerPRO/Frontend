# Azure AD — tenant corporativo único (no multi-tenant, no cuentas personales)
PUBLIC_AZURE_CLIENT_ID=<app-registration-client-id>
PUBLIC_AZURE_TENANT_ID=<tenant-id>
PUBLIC_AZURE_REDIRECT_URI=http://localhost:4321/auth/callback
PUBLIC_AZURE_POST_LOGOUT_URI=http://localhost:4321/login

# API Gateway (único punto de entrada; nunca un microservicio directo)
PUBLIC_BFF_BASE_URL=http://localhost:8080
PUBLIC_API_SCOPE=api://<client-id>/TallerPro.Access

# Talleres de la red (UUID = tallerId del backend)
PUBLIC_WORKSHOPS=[{"id":"11111111-1111-1111-1111-111111111111","name":"Taller Central"},{"id":"22222222-2222-2222-2222-222222222222","name":"Taller Norte"}]

# Feature flags
PUBLIC_ENABLE_AUDIT=true
PUBLIC_ENABLE_REPORTS=true
